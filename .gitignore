# 依赖
node_modules/
web/node_modules/
venv/
.venv/
target/

# 敏感环境变量。示例模板 .env.example 可以提交。
.env
.env.*
!.env.example

# 编译与构建产物
dist/
build/
web/dist/
web/.vite/
*.tsbuildinfo
*.local

# 日志、覆盖率、缓存
*.log
coverage/
.nyc_output/
.cache/

# 本地或自签证书。生产证书由部署机器提供，不入库。
certs/

# 备份与匿名化账本（含身份或密钥材料，不得入库）
backups/
*.dump
anon-ledger/
anon-ledger.encrypted

# Drizzle 生成物
drizzle/

# IDE：忽略个人配置，保留可共享的推荐配置
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
*.sublime-*
*.swp
*.swo
*~

# 系统临时文件
.DS_Store
Thumbs.db
Desktop.ini
