# 数据库连接。直接运行 Node 时使用；Compose 会用 POSTGRES_PASSWORD 自己组装。
DATABASE_URL=postgresql://classroom:CHANGE_ME_IN_PRODUCTION@postgres:5432/classroom_manager

# Compose 必填。同时用于 Postgres 和 API / 备份任务的连接串。
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION

# Compose 必填。
SESSION_SECRET=CHANGE_ME_IN_PRODUCTION_32_BYTES_MIN

# 服务端口（Docker 内部 3000；宿主机通过 nginx 反代不暴露）
API_PORT=3000

# 时区（服务端记录时间用 UTC，界面渲染用此时区）
TZ=Asia/Shanghai

# 备份目录与保留天数。备份容器写入 /backups，每天 02:15（Asia/Shanghai）执行。
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=30

# 检查点触发阈值（回放事件数，可调参数）
REPLAY_CHECKPOINT_EVENT_THRESHOLD=200

# 日志级别（info / debug / warn / error）
LOG_LEVEL=info

# 由 Nginx 终止 TLS 时设为 true。Compose 默认传入 true。
HTTPS_ENABLED=true

# 只信任这么多级反向代理。Compose 设为 1。
TRUST_PROXY=1

# 匿名化外部账本加密密钥（32 字节 hex，独立保管）
ANON_LEDGER_KEY=GENERATE_WITH_openssl_rand_hex_32

# 本地开发匿名化时设置可写路径；容器默认 /app/anon-ledger/ledger.jsonl.enc。
# ANON_LEDGER_PATH=anon-ledger/ledger.jsonl.enc
