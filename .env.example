# 数据库连接（Docker Compose 内部使用服务名 postgres:5432）
DATABASE_URL=postgresql://classroom:classroom_password@postgres:5432/classroom_manager

# 会话密钥（生产环境必须更换为 32+ 字节随机字符串）
SESSION_SECRET=CHANGE_ME_IN_PRODUCTION_32_BYTES_MIN

# 服务端口（Docker 内部 3000；宿主机通过 nginx 反代不暴露）
API_PORT=3000

# 时区（服务端记录时间用 UTC，界面渲染用此时区）
TZ=Asia/Shanghai

# 备份目录与保留天数。每日任务写入 backup_record，失败时退出码为 1。
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30

# 检查点触发阈值（回放事件数，可调参数）
REPLAY_CHECKPOINT_EVENT_THRESHOLD=200

# 日志级别（info / debug / warn / error）
LOG_LEVEL=info

# HTTPS（生产环境由 nginx 终止 TLS，应用本身不处理证书）
# HTTPS_ENABLED=false

# 匿名化外部账本加密密钥（32 字节 hex，独立保管）
ANON_LEDGER_KEY=GENERATE_WITH_openssl_rand_hex_32
